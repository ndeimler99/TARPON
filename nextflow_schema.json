{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/./master/nextflow_schema.json",
    "title": "epi2me-labs/wf-template",
    "workflow_title": "Template workflow",
    "description": "Nextflow workflow template repository.",
    "demo_url": "https://ont-exd-int-s3-euwst1-epi2me-labs.s3.amazonaws.com/wf-template/wf-template-demo.tar.gz",
    "aws_demo_url": "https://ont-exd-int-s3-euwst1-epi2me-labs.s3.amazonaws.com/wf-template/wf-template-demo/aws.nextflow.config",
    "url": "https://github.com/epi2me-labs/wf-template",
    "type": "object",
    "definitions": {
        
        "Input": {
            "title": "Input Files",
            "type": "object",
            "fa_icon": "fas fa-arrow-right",
            "description": "Parameters for finding and handling input data for analysis.",
            "properties": {
                "fastq_input_dir": {
                    "type": "string",
                    "format": "path",
                    "title": "FASTQ",
                    "description": "FASTQ files to use in the analysis.",
                    "help_text": "This accepts one of three cases: (i) the path to a single FASTQ file; (ii) the path to a top-level directory containing FASTQ files; (iii) the path to a directory containing one level of sub-directories which in turn contain FASTQ files. In the first and second case, a sample name can be supplied with `--sample`. In the last case, the data is assumed to be multiplexed with the names of the sub-directories as barcodes. In this case, a sample sheet can be provided with `--sample_sheet`."
                },
                "memfactor":{
                    "type": "number",
                    "default": 2,
                    "title": "Memory Scalar",
                    "description": "Scale memory usage depending on your machine"
                },
                "database_dir": {
                  "title":"Pre-Downloaded Kraken Database",
                  "type": "string",
                  "format":"path",
                  "description": "Provide the location of a predownloaded kraken database"
                },
                "database_store_dir":{
                  "title":"Database Store Dir",
                  "type":"string",
                  "format":"path",
                  "description":"Where to store the downloaded Kraken/Bracken databases"
                },
                "krona_file":{
                  "title":"Krona File",
                  "type":"string",
                  "format":"path",
                  "description":"Provide te Location of a Predownloaded Krona File"
                },
                "krona_store_dir":{
                  "title":"Krona Store Dir",
                  "type":"string",
                  "format":"path",
                  "description":"Where to store the downloaded Krona Files"
                },
                "real_time":{
                  "title":"Real-Time",
                  "type":"boolean",
                  "description":"Check this box if you want this pipeline to run in real time"
                }
            },
            
            "required": ["fastq_input_dir"]
        },

        "output": {
            "title": "Output Options",
            "type": "object",
            "fa_icon": "fas fa-arrow-left",
            "description": "Parameters for saving and naming workflow outputs.",
            "properties": {
                "out_dir": {
                    "type": "string",
                    "default": "output",
                    "format": "directory-path",
                    "description": "Directory for output of all workflow results."
                }
            }
        },
        
        "Clean_Filter":{
            "title": "Cleaning & Filtering parameters",
            "type": "object",
            "fa_icon": "fas fa-arrow-right",
            "description":"Set parameters for cleaning",
            "properties":{
                "QC":{
                    "type": "boolean",
                    "description": "For QC, Tick it!",
                    "default":true
                    },
                "trim":{
                    "type": "boolean",
                    "description": "Trim the read",
                    "default": true
                    },
                "porechop_abi": {
                    "type": "boolean",
                    "description": "porechop abi",
                    "default": false
                      },
                "min_len": {
                    "type": "integer",
                    "description": "Minimum length (default: 1400)",
                    "default": 1400
                      },
                "max_len": {
                    "type": "integer",
                    "description": "Maximum length (default: 1600)",
                    "default": 1600
                      },
                "min_read_qual": {
                    "type": "integer",
                    "description": "Min read quality ",
                    "default": 0
                      },
                "headcrop": {
                    "type": "integer",
                    "description": "Headcrop (default: 0)",
                    "default": 0
                      },
                "tailcrop": {
                    "type": "integer",
                    "description": "Tail crop (default: 0)",
                    "default": 0
                      }
                  
              }
        }, 
        "Minimap2":{
                "title": "Minimap2 parameters",
                "type": "object",
                "fa_icon": "fas fa-arrow-right",
                "description": "prepare mapping command",
                "properties": {
                  "minimap2": {
                    "title": "Enter the minimap2 command with parameters",
                    "description": "Minimap 2.",
                    "type": "string",
                    "default":"-k 15 -K 25M --print-qname -aLx map-ont"
                  }
                }
        },

        "Kraken2":{
                "title": "Kraken2 parameters",
                "type": "object",
                "fa_icon": "fas fa-arrow-right",
                "description": "Enter the Kraken2 parameters",
                "properties": {
                  "kraken": {
                    "title": "Classifier (Kraken 2)",
                    "description": "Kraken 2 ",
                    "type": "boolean",
                    "default": true
                  },
                  "db_type": {
                    "title": "Database name",
                    "description": "Database (default: Silva)",
                    "type": "string",
                    "default": "silva"
                  },
                  "k_kmer": {
                    "title": "K-mer",
                    "description": "K-mer (default: 21)",
                    "type": "integer",
                    "default": 21
                  },
                  "minimizer_len": {
                    "title": "Minimizer Length",
                    "description": "Minimizer length (default 17)",
                    "type": "integer",
                    "default": 17
                  },
                  "minimizer_spaces": {
                    "title": "Minimizer Space",
                    "description": "Minimizer Spaces (default: 4)",
                    "type": "integer",
                    "default": 4
                  }
                }
        },

        "Bracken":{
                "title": "Bracken parameters",
                "type": "object",
                "fa_icon": "fas fa-arrow-right",
                "properties": {
                  "bracken": {
                    "title": "Bracken",
                    "description": "Bracken",
                    "type": "boolean",
                    "default": true
                  },
                  "level": {
                    "title": "Level",
                    "description": "Level (default: G",
                    "type": "string",
                    "default":"G",
                    "enum": ["D", "P", "C", "O", "F", "G"]
                  },
                  "b_kmer": {
                    "title": "b-kmer",
                    "description": "b-kmer (default 21)",
                    "type": "integer",
                    "default": 21
                  },
                  "read_length": {
                    "title": "Read Length",
                    "description": "Read Length (default: 1450)",
                    "type": "integer",
                    "default": 1450
                  },
                  "b_threshold": {
                    "title": "b-threshold",
                    "description": "b-threshold (default : 2)",
                    "type": "integer",
                    "default": 2
                  }
                }
        }
        
    },
    "allOf": [
        {
            "$ref": "#/definitions/Input"
        },
        {
            "$ref": "#/definitions/output"
        },
        {
            "$ref": "#/definitions/Clean_Filter"
        },
        {
            "$ref": "#/definitions/Database"
        },
        {
            "$ref": "#/definitions/Minimap2"
        },
        {
            "$ref": "#/definitions/Kraken2"
        },
        {
            "$ref": "#/definitions/Bracken"
        }
    ],
    "properties": {
        "aws_image_prefix": {
            "type": "string",
            "description": "AWS image prefix",
            "hidden": true
        },
        "aws_queue": {
            "type": "string",
            "description": "AWS Queue",
            "hidden": true
        },
        "monochrome_logs": {
            "type": "boolean",
            "description": "Monochrome logs"
        },
        "validate_params": {
            "type": "boolean",
            "description": "Validate parameters",
            "default": true
        },
        "show_hidden_params": {
            "type": "boolean",
            "description": "Show hidden parameters"
        }
    },
    "resources": {
        "recommended": {
            "cpus": 2,
            "memory": "2GB"
        },
        "minimum": {
            "cpus": 2,
            "memory": "2GB"
        },
        "run_time": "5 minutes per sample",
        "arm_support": true 
    }
}
