{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/./master/nextflow_schema.json",
    "title": "ndeimler99/TArPON",
    "workflow_title": "Tarpon",
    "description": "Telomere Analysis Pipeline On Nanopore Sequencing Data",
    "demo_url": "demo_url",
    "aws_demo_url": "aws_demo_url",
    "url": "https://github.com/ndeimler99/TArPON",
    "type": "object",
    "definitions": {
        "Input": {
            "title": "Mandatory Input",
            "type": "object",
            "fa_icon": "fas fa-arrow-right",
            "description": "Mandatory parameters for basic analysis",
            "properties": {
                "input_file": {
                    "type": "string",
                    "format": "path",
                    "title": "FASTQ Input File",
                    "description": "FASTQ File from Sequencing",
                    "help_text": ""
                },
                "outdir": {
                  "type": "string",
                  "format": "path",
                  "title": "Output Directory",
                  "description": "Desired Output Location",
                  "help_text": "This should be a path to a directory to store the output data. The parent directory should exist. If the main directory does not exist it will be created"
                },
                "overwrite_outdir": {
                  "type": "boolean",
                  "title": "Overwrite Output Directory?",
                  "help_text": "Set this to true if the output directory already exists but you would like to overwrite the data"
                },
                "repeat": {
                  "type": "string",
                  "title": "Telomeric Repeat Sequence (G-Strand)",
                  "help_text": "Please supply the telomeric sequence found on the G strand, for examples and most vertebrata, GGTTAG"
                },
                "minimum_telo_reads_per_sample": {
                  "type": "number",
                  "title": "Minimum Number of Telomeres Per Sample",
                  "help_text": "Samples will be marked as failed if minimum number of telomeres is below this threshold"
                },
                "c_strand_only": {
                  "type": "boolean",
                  "title": "C Strand Analysis Only",
                  "help_text": "If the data was collected in such a way that only C strand telomeric sequences should be expected (i.e. ONT protocol), select this box"
                }
            },
            
            "required": ["fastq_input"]
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/Input"
        },
        {
            "$ref": "#/definitions/output"
        },
        {
            "$ref": "#/definitions/Clean_Filter"
        },
        {
            "$ref": "#/definitions/Database"
        },
        {
            "$ref": "#/definitions/Minimap2"
        },
        {
            "$ref": "#/definitions/Kraken2"
        },
        {
            "$ref": "#/definitions/Bracken"
        }
    ],
    "properties": {
        "aws_image_prefix": {
            "type": "string",
            "description": "AWS image prefix",
            "hidden": true
        },
        "aws_queue": {
            "type": "string",
            "description": "AWS Queue",
            "hidden": true
        },
        "monochrome_logs": {
            "type": "boolean",
            "description": "Monochrome logs"
        },
        "validate_params": {
            "type": "boolean",
            "description": "Validate parameters",
            "default": true
        },
        "show_hidden_params": {
            "type": "boolean",
            "description": "Show hidden parameters"
        }
    },
    "resources": {
        "recommended": {
            "cpus": 2,
            "memory": "2GB"
        },
        "minimum": {
            "cpus": 2,
            "memory": "2GB"
        },
        "run_time": "5 minutes per sample",
        "arm_support": true 
    }
}
