[2m--------------------------------------------------------------------------------[0m
Typical pipeline command:

  [0;36mnextflow run ndeimler99/TArPON \ 
	--input_file 'test_data/*.fastq' --sample_file 'test_data/test_data.csv'[0m

[4m[1mInput and Output Parameters[0m
  --input_file                    [2m[string]  [0mFASTQ File from Sequencing[2m[0m
  --run_name                      [2m[string]  [0mTitle of Sequencing Run for Generation of Output Files[2m[0m
  --sample_name                   [2m[string]  [0mName of sample when sequencing contains only one sample[2m[0m
  --sample_file                   [2m[string]  [0mCSV file containing sample names and barcodes to use for demultiplexing. If no adaptor sequence is provided the 
                                            barcodes will also be used for determing the end of the telomere[2m[0m 
  --adaptor_sequence              [2m[string]  [0mProvide the first 12 nucleotides of the capture sequence that would appear on the G strand telomeric sequences[2m 
                                            [default: ACTTCGTTCGGT][0m 
  --outdir                        [2m[string]  [0mThis should be a path to a directory to store the output data. The parent directory should exist. If the main 
                                            directory does not exist it will be created[2m [default: output][0m 
  --overwrite_outdir              [2m[boolean] [0mSet this to true if the output directory already exists but you would like to overwrite the data[2m[0m

[4m[1mBasic Pipeline Options[0m
  --repeat                        [2m[string]  [0mPlease supply the telomeric sequence found on the G strand, for examples and most vertebrata, GGTTAG[2m [default: 
                                            GGTTAG][0m 
  --minimum_telo_reads_per_sample [2m[number]  [0mSamples will be marked as failed if minimum number of telomeres is below this threshold[2m [default: 500][0m
  --c_strand_only                 [2m[boolean] [0mIf the data was collected in such a way that only C strand telomeric sequences should be expected (i.e. ONT 
                                            protocol), select this box[2m[0m 
  --repeat_count                  [2m[number]  [0mNumber of repeats a read must contain to be considered putatively telomeric[2m [default: 10][0m
  --reverse_complement_threshold  [2m[number]  [0mPercentage of telomeric repeats must be greater than this value to be classified as C strand. If the percentage is 
                                            less than 1 minus this value, the read is classified as C strand. Anthing greater than 1-value but less than value 
                                            is removed from analysis[2m [default: 0.80][0m 

[4m[1mAdaptor Identification, Demultiplexing, and Subtelomeric Filtering Parameters[0m
  --adaptor_sequence_errors       [2m[number]  [0mNumber of allowed errors to be found in the adaptor sequence. The adaptor sequence wil only be found after ten 
                                            telomeric repeats. It is recomended this value be 2 for a 12 nucleotide adaptor sequence. For each additional 8bp, 
                                            the number of errors should be increased by 1[2m [default: 2][0m 
  --barcode_errors                [2m[number]  [0mNumber of allowed errors in the barcode sequence. It is recomended this value by 1/8 the length of the barcode 
                                            assuming the hamming distance between barcodes is greater than 1/8 the barcode length[2m [default: 3][0m 
  --min_subtelo_length            [2m[number]  [0mMinimum Read Lenth Before VRR region Telomeric Start Site to Ensure sequencing completely through telomeres[2m 
                                            [default: 300][0m 
  --subtelo_threshold             [2m[number]  [0mMaximum percentage of one nucleotide substitutions of telomeric sequences found within min_subtelo_length before 
                                            read does not pass filtering criteria[2m [default: 0.3][0m 

[4m[1mDetermining Telomere Start Position[0m
  --sliding_window_size           [2m[number]  [0mLength of the sliding window analyzed for the identification of telomeric start[2m [default: 200][0m
  --sliding_window_interval       [2m[number]  [0mHow many base pairs will the sliding window jump each time rather than operating on a nucleotide by nucleotide 
                                            slide[2m [default: 10][0m 
  --upper_threshold               [2m[number]  [0mThe percentage of which a sliding window must consist of one nucleotide repeat variations for the telomere to start. 
                                            Must be a value between 0 and 1[2m [default: 0.6][0m 
  --lower_threshold               [2m[number]  [0mSliding window one nucleotide variation percentage must not drop below this value after upper threshold has been 
                                            surpassed.[2m [default: 0.1][0m 
  --telomeric_repeat_percentage   [2m[number]  [0mAdditional filtering step that removes telomeres that consist of less than this percentage one nucleotide variant 
                                            repeats from the VRR start to the adaptor sequence[2m [default: 0.7][0m 
  --consecutive_repeats           [2m[number]  [0mAll perfect repeats existing in a strecth of x or more consecutive repeats between the VRR start and the adaptor 
                                            will be considered in telomere length calculations[2m [default: 3][0m 

[4m[1mAdvanced Options[0m
  --detailed_stats                [2m[boolean] [0mAdditional sets of plots analysing telomeric reads are created. See README for more details[2m[0m
  --strand_comparison             [2m[boolean] [0mGenerate Plots Directly comparing C to G strand results[2m[0m
  --indiv_read_plots              [2m[boolean] [0mGenerate Plots showing individual reads and telomeric start identification[2m[0m
  --plot_vrr_length               [2m[boolean] [0mIf set to true additional plots will be created mirroring those for telomere length analysis, but using the VRR 
                                            length instead of calculated telomere length[2m[0m 
  --restriction_digest_analysis   [2m[string]  [0mProvide a list of comma seperated restriction enzyme sites for an analysis of digestion completion[2m[0m
